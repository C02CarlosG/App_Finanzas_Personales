# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
PORT=3000
# En un servicio administrado (Neon, etc.): cadena DIRECTA (sin pooler) y ?sslmode=verify-full. Ver docs/despliegue.md.
DATABASE_URL=postgres://usuario:password@localhost:5432/finanzas
# Cadena larga y aleatoria, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
# Solo para pruebas: la BD debe terminar en _test (las pruebas la vacían).
TEST_DATABASE_URL=postgres://usuario:password@localhost:5432/finanzas_test
# Margen (ms) del pull de sync; ver docs/sync.md
SYNC_SAFETY_LAG_MS=5000
# Intentos fallidos de contraseña por ventana (login y confirmaciones de Perfil) y duración de la ventana (ms).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
# Detrás de un proxy/balanceador: número de saltos de confianza (p. ej. 1). Sin definir, se usa la IP directa.
# TRUST_PROXY=1
# Días que se conserva un registro borrado antes de purgarlo del servidor (0 = nunca). Ver docs/sync.md §7.
TOMBSTONE_RETENTION_DAYS=180
